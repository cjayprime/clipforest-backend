{
  "name": "@cliprover/api",
  "version": "1.0.0",
  "private": true,
  "description": "ClipRover product API (NestJS): auth, videos, uploads, candidates, renders, realtime events.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm --prefix .. run lint",
    "lint:fix": "npm --prefix .. run lint:fix",
    "test": "jest",
    "migration:run": "typeorm migration:run -d dist/core/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/core/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/core/data-source.js src/migrations/Change",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/s3-request-presigner": "3.1129.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nestjs-pino": "4.6.1",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "roots": [
      "<rootDir>/../tests/api"
    ],
    "setupFiles": [
      "<rootDir>/../tests/api/jest.setup.ts"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tests/api/tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
