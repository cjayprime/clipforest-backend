# ClipRover backend environment. Copy to .env and fill in. Never commit real secrets.
#
# One file serves the whole backend repo:
#   • Docker Compose reads it   — cd infra && docker compose --env-file ../.env up -d
#   • The API reads it natively — backend/api/src/config.ts loads ../../.env via dotenv
#
# Host-side values (localhost) and container-side values (S3_ENDPOINT_INTERNAL,
# POSTGRES_*) use different variable names, so the same file is correct for both:
# docker-compose.yml builds the containers' DATABASE_URL/REDIS_URL/S3_ENDPOINT itself.
#
# NOTE: Compose reads this file literally — everything after "=" is the value.
# Never put a comment on the same line as a setting.

# ----------------------------------------------------------------- Compose
# Profiles: local-s3 = MinIO stand-in for R2 (local dev); apps = containerized API + Caddy.
# Local development runs the API natively, so only local-s3 is enabled here.
# Production: COMPOSE_PROFILES=apps with S3_* pointing at Cloudflare R2.
COMPOSE_PROFILES=local-s3

# Public address for Caddy (apps profile). ":80" = plain HTTP; a domain = automatic HTTPS.
# The API is the only thing Caddy serves — the web app is a separate deployment.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Origin users load the web app from (API CORS).
# The frontend repo runs on :3000 in development.
PUBLIC_WEB_URL=http://localhost:3000

# Origins allowed to upload straight to MinIO (local-s3 profile only), comma-separated.
# Browsers upload directly to storage, and localhost and 127.0.0.1 are different origins.
# With Cloudflare R2 this is the bucket's CORS policy instead (docs/deployment.md).
MINIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- Database
# Used by Compose to provision the postgres container:
POSTGRES_USER=cliprover
# Change in production.
POSTGRES_PASSWORD=cliprover
POSTGRES_DB=cliprover
# Used by the API when it runs natively against that container:
DATABASE_URL=postgresql://cliprover:cliprover@localhost:5432/cliprover
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------------- Auth
# Long random string (e.g. `openssl rand -hex 32`). Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# true behind HTTPS (production); false for http://localhost.
COOKIE_SECURE=false
# Minutes a password reset link stays valid. Links are single use.
PASSWORD_RESET_TTL_MINUTES=60
# Seconds to cache "when did this password last change" in the API.
# 0 = a password change signs other devices out immediately.
REVOCATION_CACHE_SECONDS=0

# ------------------------------------------------------------------- Email
# Transactional email: password reset, password-changed notice, welcome.
# auto = Brevo when BREVO_API_KEY is set, otherwise messages are printed to the
# API log — which is how the reset flow works with no account. Force one with
# MAIL_PROVIDER=brevo | console | noop.
MAIL_PROVIDER=auto
BREVO_API_KEY=
# Brevo only accepts senders you have verified (a domain or a single sender).
MAIL_FROM_EMAIL=no-reply@cliprover.local
MAIL_FROM_NAME=ClipRover
# Optional address replies should go to.
MAIL_REPLY_TO=
MAIL_TIMEOUT_MS=10000
# Local only: serve recent emails from GET /api/dev/mail so the reset link can be
# followed without an inbox. Forced off when NODE_ENV=production.
MAIL_TEST_INBOX=1

# ----------------------------------------------------------------- Billing
# Polar (polar.sh) subscriptions. Leave POLAR_ACCESS_TOKEN empty to keep billing
# switched off: the app runs normally, nothing is charged, no plan is active.
POLAR_ACCESS_TOKEN=
# From the webhook endpoint you create in Polar. Deliveries are rejected without it.
POLAR_WEBHOOK_SECRET=
# sandbox until you are ready to take real payments.
POLAR_SERVER=sandbox
# Production is https://api.polar.sh. Point this at Polar's sandbox host while
# POLAR_SERVER=sandbox — check their current docs for the value.
POLAR_API_BASE=https://api.polar.sh
# The Polar product for each plan on the pricing page; this is how a paid order
# is mapped back to a monthly credit allowance. Polar sells annual pricing as a
# separate product, so each plan has a monthly and an annual one. The pricing
# page only offers an interval once all three plans have a product for it.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_CREATOR=
POLAR_PRODUCT_STUDIO=
POLAR_PRODUCT_STARTER_ANNUAL=
POLAR_PRODUCT_CREATOR_ANNUAL=
POLAR_PRODUCT_STUDIO_ANNUAL=
# Replay window for webhook signatures, in seconds.
POLAR_WEBHOOK_TOLERANCE_SEC=300

# Share of each monthly grant that rolls over into later months (0.9 = 90%).
# The remainder is use-it-or-lose-it, and the split happens at grant time.
CREDIT_ROLLOVER_SHARE=0.9

# Whether work costs credits. Off: nothing is charged or refused. On: the API
# refuses work the balance cannot cover and the worker debits it, refunding
# anything that fails. Read by both the API and the worker.
CREDITS_ENFORCED=false
# Per started minute of source video, charged once when the video is processed.
# Re-analysing an already processed video is free.
CREDIT_COST_PER_SOURCE_MINUTE=1
# Per clip render, including re-renders. Identical re-requests are deduplicated
# and cost nothing.
CREDIT_COST_PER_RENDER=1
# Cron expression for granting annual subscribers their monthly allowance
# (Polar bills them once a year).
CREDIT_ANNUAL_ALLOWANCE_CRON=0 * * * *

# ----------------------------------------------------------------- Storage
# Local MinIO defaults below. For Cloudflare R2 set every endpoint to
# https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_FORCE_PATH_STYLE=false, and use an R2 API token's key pair.
#
# Reachable from the API running natively on the host:
S3_ENDPOINT=http://localhost:9000
# Reachable from the worker/api containers:
S3_ENDPOINT_INTERNAL=http://minio:9000
# Reachable from the browser (signed upload/playback URLs):
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cliprover
S3_ACCESS_KEY_ID=cliprover
S3_SECRET_ACCESS_KEY=cliprover-secret
S3_FORCE_PATH_STYLE=true
# url = FFmpeg reads source ranges over signed HTTP (no multi-GB downloads); download = copy to disk first.
SOURCE_READ_MODE=url

# ------------------------------------------------------------------ Limits
# 5 GB
MAX_UPLOAD_BYTES=5368709120
# 3 hours
MAX_VIDEO_DURATION_SEC=10800
# Default UI score threshold (users can lower it).
MIN_CANDIDATE_SCORE=40
# Files at or above this size upload in parallel parts. 67108864 (64 MB) in production;
# lowered here so ordinary test files still exercise the multipart path.
MULTIPART_THRESHOLD_BYTES=20971520
# Heavy jobs are refused below this much free disk.
DISK_MIN_FREE_BYTES=5368709120
# Delete superseded render versions / sources after N days (0 = keep forever).
RENDER_RETENTION_DAYS=0
SOURCE_RETENTION_DAYS=0

# ----------------------------------------------------------- Transcription
# auto = first configured of assemblyai, deepgram, whisper-api; otherwise the offline mock provider.
# Leave the keys empty to run fully offline.
TRANSCRIPTION_PROVIDER=auto
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Any OpenAI-compatible /audio/transcriptions endpoint.
WHISPER_API_KEY=
# WHISPER_API_BASE=https://api.openai.com/v1
#
# local-whisper (faster-whisper on CPU) is opt-in; see docs/deployment.md before enabling it.

# ---------------------------------------------------------- Highlight LLM
# auto = whichever key is set (Anthropic first, then OpenAI); otherwise the offline
# heuristic scorer. Force one with LLM_PROVIDER=anthropic | openai | heuristic.
LLM_PROVIDER=auto
#
# Anthropic:
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
#
# OpenAI (set OPENAI_MODEL to a model your key can use):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: an OpenAI-compatible gateway base URL.
OPENAI_BASE_URL=
#
# Optional reasoning effort, applied to either provider: low | medium | high | xhigh | max
LLM_EFFORT=

# -------------------------------------------------------------- Rendering
X264_PRESET=veryfast
FFMPEG_THREADS=3
WORKER_CPUS=3
CONCURRENCY_TRANSCRIPTION=3
CONCURRENCY_ANALYSIS=6
# Comma-separated queues this worker consumes (render-only hosts: WORKER_QUEUES=render).
WORKER_QUEUES=video-ingest,transcription,analysis,render,cleanup

# ----------------------------------------------------------- Observability
# Optional bearer token for /api/metrics.
METRICS_TOKEN=
LOG_LEVEL=debug
WORKER_LOG_LEVEL=INFO
