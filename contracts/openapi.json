  "info": {
    "title": "ClipRover API",
    "description": "Product API for the ClipRover AI short-form clipping platform. All endpoints require a session cookie (cr_session) or Bearer token unless marked public. Errors use the envelope { error: { code, message, retryable, correlationId } }.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cr_session"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "StartCheckoutDto": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "starter",
              "creator",
              "studio"
            ]
          },
          "interval": {
            "type": "string",
            "description": "Defaults to monthly. Annual is a separate Polar product per plan.",
            "enum": [
              "month",
              "year"
            ]
          }
        },
        "required": [
          "plan"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "description": "\"upload\" for direct-to-storage upload, \"url\" for a supported source link.",
            "enum": [
              "upload",
              "url"
            ]
          },
          "originalFilename": {
            "type": "string",
            "maxLength": 255
          },
          "contentType": {
            "type": "string",
            "maxLength": 100
          },
          "sizeBytes": {
            "type": "number",
            "minimum": 1
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "rightsConfirmed": {
            "type": "boolean",
            "description": "The user confirms they own or are authorized to process this content."
          }
        },
        "required": [
          "sourceType",
          "rightsConfirmed"
        ]
      },
      "SignPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "CompletedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "partNumber",
          "etag"
        ]
      },
      "UploadCompleteDto": {
        "type": "object",
        "properties": {
          "parts": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartDto"
            }
          },
          "observedSizeBytes": {
            "type": "number",
            "description": "Size the client observed locally (informational; storage is authoritative).",
            "minimum": 0
          }
        }
      },
      "CaptionsDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "preset": {
            "type": "string",
            "enum": [
